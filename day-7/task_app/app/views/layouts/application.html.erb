<!DOCTYPE html>
<html>
  <head>
    <title>TaskApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen">
    <header class="bg-indigo-600 text-white shadow-md">
      <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
        <h1 class="text-xl font-bold tracking-tight">TaskTracker</h1>
        <%= link_to "Home", root_path, class: "hover:underline text-sm font-medium" %>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <% if flash[:notice] %>
        <div class="mb-6 p-4 text-sm text-emerald-800 bg-emerald-100 rounded-lg border border-emerald-200">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
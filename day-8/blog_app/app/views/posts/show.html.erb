<div class="max-w-2xl mx-auto py-8 px-4">
  <%= link_to "← Back to Posts", root_path, class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium mb-6 inline-block" %>

  <!-- Post Content -->
  <article class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-8">
    <h1 class="text-3xl font-bold text-slate-900 mb-3"><%= @post.title %></h1>
    <p class="text-xs text-slate-400 mb-6">Published <%= time_ago_in_words(@post.created_at) %> ago</p>
    <div class="text-slate-700 leading-relaxed whitespace-pre-line"><%= @post.body %></div>
  </article>

  <!-- Comments Section -->
  <section class="space-y-6">
    <h2 class="text-xl font-bold text-slate-900">
      Comments (<%= @post.comments.reject(&:new_record?).count %>)
    </h2>

    <!-- List Existing Comments -->
    <div class="space-y-4">
      <% @post.comments.each do |comment| %>
        <% if comment.persisted? %>
          <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
            <p class="text-slate-700 text-sm"><%= comment.body %></p>
            <span class="text-xs text-slate-400 mt-2 block"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Add Comment Form -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mt-6">
      <h3 class="text-base font-semibold text-slate-900 mb-4">Leave a comment</h3>

      <%= form_with(model: [@post, @comment], local: true, class: "space-y-4") do |f| %>
        <% if @comment.errors.any? %>
          <div class="p-3 bg-red-50 text-xs text-red-700 rounded-lg">
            <%= @comment.errors.full_messages.join(", ") %>
          </div>
        <% end %>

        <div>
          <%= f.text_area :body, rows: 3, class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Write a comment..." %>
        </div>

        <%= f.submit "Post Comment", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-lg text-sm shadow-sm transition cursor-pointer" %>
      <% end %>
    </div>
  </section>
</div>
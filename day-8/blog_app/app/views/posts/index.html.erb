<div class="max-w-3xl mx-auto py-8 px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Blog Posts</h1>
    <%= link_to "New Post", new_post_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition" %>
  </div>

  <% if @posts.any? %>
    <div class="space-y-6">
      <% @posts.each do |post| %>
        <article class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
          <h2 class="text-xl font-bold text-slate-900 hover:text-indigo-600">
            <%= link_to post.title, post %>
          </h2>
          <p class="text-slate-600 mt-2 line-clamp-3"><%= post.body %></p>
          <div class="mt-4 flex justify-between items-center text-xs text-slate-400">
            <span>Posted <%= time_ago_in_words(post.created_at) %> ago</span>
            <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full font-medium">
              <%= pluralize(post.comments.count, "comment") %>
            </span>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-dashed border-slate-300">
      <p class="text-slate-500 mb-4">No posts found yet.</p>
      <%= link_to "Create your first post", new_post_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
    </div>
  <% end %>
</div>